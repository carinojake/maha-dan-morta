static func get_chapter(ch: int) -> Dictionary:
	return CHAPTERS.get(clampi(ch, 1, TOTAL_CHAPTERS), CHAPTERS[1])


static func get_zone_name(ch: int, room_idx: int) -> String:
	var c := get_chapter(ch)
	var zones: Array = c["zones"]
	if room_idx <= 3:
		return str(zones[0])
	elif room_idx <= 8:
		return str(zones[1])
	return str(zones[2])


static func get_floor_number(ch: int, room_idx: int) -> int:
	return (clampi(ch, 1, TOTAL_CHAPTERS) - 1) * ROOMS_PER_CHAPTER + clampi(room_idx, 0, ROOMS_PER_CHAPTER - 1) + 1
